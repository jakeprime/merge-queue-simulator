#!/usr/bin/env ruby
# frozen_string_literal: true

require 'dry/cli'

require_relative 'app/merge_queue'

module Cli
  extend Dry::CLI::Registry

  class MergeQueue < Dry::CLI::Command
    option :auto,
           type: :boolean,
           aliases: ['-a'],
           default: true,
           desc: 'Run simulator automatically'

    option :persist_log,
           type: :boolean,
           default: false,
           desc: 'Keep all log messages on screen'

    option :flakiness,
           type: :integer,
           aliases: ['-f'],
           default: 0,
           desc: 'Number of successful CI runs per flake, 0 for no flakes'

    option :ci_run_time,
           type: :string,
           aliases: ['-c'],
           default: '10m',
           desc: <<~DESC
             Time taken for CI to run
             \t\t\t\t      The units can be s (seconds) or m (minutes)
             \t\t\t\t      e.g. 3 minutes would be `--ci 3m`
           DESC

    option :commits,
           type: :integer,
           aliases: ['-C'],
           default: 3,
           desc: 'Upper range for random number of commits per feature when --auto is true'

    option :duration,
           type: :string,
           aliases: ['-d'],
           default: '1d',
           desc: <<~DESC
             Length of "real" time to simulate run time for
             \t\t\t\t      The units can be h (hours), d (days), w(weeks)
             \t\t\t\t      e.g. 3 days would be `--time 3d`
             \t\t\t\t      To simulate a working week 8h == 1d and 5d == 1w
           DESC

    option :merges_per_day,
           type: :integer,
           aliases: ['-m'],
           default: 10,
           desc: 'Number of PR merges attempted per day'

    option :silent,
           type: :boolean,
           default: false,
           desc: 'Don’t show log outputs on screen'

    option :strategy,
           type: :string,
           aliases: ['-s'],
           default: 'sq',
           desc: <<~DESC
             Merge strategy
             \t\t\t\t      sq (default):\tSingle branch at a time runs CI on queued up PRs
             \t\t\t\t      mq:\t\tNew CI branch for each PR, including previous unmerged PRs
             \t\t\t\t      rebase:\t\tNo merge queues, but folks rebase to main before merging
             \t\t\t\t      cleo:\t\tNo rules, you do you
           DESC

    def call(auto:, ci_run_time:, commits:, duration:, flakiness:, merges_per_day:, persist_log:, strategy:, silent:)
      mq = ::MergeQueue.new
      mq.config do |config|
        config.auto = auto
        config.ci_run_time = parse_time(ci_run_time)
        config.commits = commits.to_i
        config.duration = parse_time(duration)
        config.flakiness = ratio(flakiness)
        config.merges_per_day = merges_per_day.to_i
        config.persist_log = persist_log
        config.strategy = strategy
        config.silent = silent
      end
      mq.call
    end

    def ratio(input)
      return 0.0 if input.to_i.zero?

      1.0 / input.to_i
    end

    def parse_time(input)
      number = input.to_i
      unit = input[-1]

      method = {
        's' => :seconds,
        'm' => :minutes,
        'h' => :hours,
        'd' => :days,
        'w' => :weeks,
      }[unit]

      number.public_send(method)
    end
  end
end

Dry::CLI.new(Cli::MergeQueue).call
